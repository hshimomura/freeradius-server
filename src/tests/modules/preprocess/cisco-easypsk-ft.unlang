#
#  Verify that rlm_preprocess reassembles both Cisco fragments in request
#  order and exposes exactly one complete FT-PSK EAPoL-Key frame.
#
preprocess

if (!&request:Tmp-String-0 || !&request:Tmp-Octets-0 || !&request:Tmp-Octets-1 || !&request:Tmp-Octets-2) {
	reject
}

if (&request:Tmp-String-0 != "EasyPSK") {
	reject
}

if (&request:Tmp-Octets-0 != 0x6cab059e2c2a) {
	reject
}

if (&request:Tmp-Octets-1 != 0xba68f260c749b30e1fdb0fc57b4b15185d966ba2abece6bd1dd541beabedf4ae) {
	reject
}

if (&request:Tmp-Octets-2 != ) {
	reject
}

if (&request:Tmp-String-0[1] || &request:Tmp-Octets-0[1] || &request:Tmp-Octets-1[1] || &request:Tmp-Octets-2[1]) {
	reject
}

update reply {
	Filter-Id := "success"
}

update control {
	Cleartext-Password := "%{User-Name}"
}
